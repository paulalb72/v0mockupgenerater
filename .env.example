V0_API_KEY=
INBOUND_WEBHOOK_SECRET=
COMPLETION_WEBHOOK_URL=https://mmpagent.makemyki.de/api/webhooks/website-agent
COMPLETION_WEBHOOK_SECRET=

# Required: the base64 logo is uploaded here and the public URL is passed to v0.
# Create a Blob store in the Vercel project; the token is provided automatically
# on Vercel, or set it manually for local runs.
BLOB_READ_WRITE_TOKEN=

# Required for the daily logo cleanup cron (GET /api/cleanup). Vercel sends this
# value as "Authorization: Bearer <CRON_SECRET>" on scheduled invocations.
CRON_SECRET=

# Optional: delete uploaded logos older than this many days (default 7).
BLOB_RETENTION_DAYS=7

# Required on Vercel when using @sparticuz/chromium-min.
# Keep the major Chromium version aligned with package.json.
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar

# Optional local Chrome/Chromium path. Takes precedence over CHROMIUM_PACK_URL.
CHROME_EXECUTABLE_PATH=

# Optional overrides
V0_API_URL=https://api.v0.dev/v1
# v0 response mode: "sync" returns the finished result directly (no polling).
# "async" returns immediately and the service polls for completion.
V0_RESPONSE_MODE=sync
CRAWLER_MAX_PAGES=15
CRAWLER_MAX_TEXT_CHARS=80000
V0_POLL_INTERVAL_SECONDS=10
V0_MAX_POLL_ATTEMPTS=90
